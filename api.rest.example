# For example http://127.0.0.1:9093
@baseUrl = http://{{$dotenv APP_HOST}}:{{$dotenv APP_PORT}}

@adminFirstName = {{$dotenv STRAPI_ADMIN_FIRSTNAME}}
@adminLastName = {{$dotenv STRAPI_ADMIN_LASTNAME}}
@adminEmail = {{$dotenv STRAPI_ADMIN_EMAIL}}
@adminPassword = {{$dotenv STRAPI_ADMIN_PASSWORD}}
@adminResetCode = {{$dotenv STRAPI_ADMIN_RESET_TOKEN}}
@adminResetPassword = {{$dotenv REST_ADMIN_RESET_PASSWORD}}
@adminToken = {{$dotenv STRAPI_ADMIN_TOKEN}}
@rememberMe = {{$dotenv REST_REMEMBER_ME}}

@userUsername = {{$dotenv REST_USER_USERNAME}}
@userEmail = {{$dotenv REST_USER_EMAIL}}
@userPassword = {{$dotenv REST_USER_PASSWORD}}
@userIdentifier = {{$dotenv REST_USER_IDENTIFIER}}
@userResetCode = {{$dotenv REST_USER_RESET_CODE}}
@userResetPassword = {{$dotenv REST_RESET_PASSWORD}}
@userToken = {{$dotenv REST_USER_TOKEN}}

@studentId = {{$dotenv REST_STUDENT_ID}}
@studentCode = {{$dotenv REST_STUDENT_CODE}}
@studentFirstname = {{$dotenv REST_STUDENT_FIRSTNAME}}
@studentLastname = {{$dotenv REST_STUDENT_LASTNAME}}
@studentEmail = {{$dotenv REST_STUDENT_EMAIL}}

@subjectId = {{$dotenv REST_SUBJECT_ID}}
@subjectCode = {{$dotenv REST_SUBJECT_CODE}}
@subjectName = {{$dotenv REST_SUBJECT_NAME}}
@subjectCredit = {{$dotenv REST_SUBJECT_CREDIT}}

@teacherId = {{$dotenv REST_TEACHER_ID}}
@teacherCode = {{$dotenv REST_TEACHER_CODE}}
@teacherFirstname = {{$dotenv REST_TEACHER_FIRSTNAME}}
@teacherLastname = {{$dotenv REST_TEACHER_LASTNAME}}
@teacherEmail = {{$dotenv REST_TEACHER_EMAIL}}

### 1. Admin Section
### 1.1 Register Admin
# @name adminRegister
POST {{baseUrl}}/admin/auth/register-admin
Content-Type: application/json

{
  "firstname": "{{adminFirstName}}",
  "lastname": "{{adminLastName}}",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": {{rememberMe}}
}

### 1.2 Admin Login
# @name adminLogin
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": {{rememberMe}}
}

### 1.3 Admin Forgot Password
# @name adminForgotPassword
POST {{baseUrl}}/admin/auth/forgot-password
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

### 1.4 Admin Profile
# @name adminProfile
GET {{baseUrl}}/admin/auth/users/me
Authorization: Bearer {{adminToken}}

### 1.5 Admin Reset Password
# @name adminResetPasswordRequest
POST {{baseUrl}}/admin/auth/reset-password
Content-Type: application/json

{
  "code": "{{adminResetCode}}",
  "password": "{{adminResetPassword}}",
  "passwordConfirmation": "{{adminResetPassword}}"
}

### 1.6 Admin Logout
# @name adminLogout
POST {{baseUrl}}/admin/logout
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{}

### 2. User Section
### 2.1 User Register
# @name userRegister
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "{{userUsername}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.2 User Login
# @name userLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "{{userIdentifier}}",
  "password": "{{userPassword}}"
}

### 2.3 User Forgot Password
# @name userForgotPassword
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{userEmail}}"
}

### 2.4 User Profile
# @name userProfile
GET {{baseUrl}}/api/auth/users/me
Authorization: Bearer {{userToken}}

### 2.5 User Reset Password
# @name userResetPasswordRequest
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "code": "{{userResetCode}}",
  "password": "{{userResetPassword}}",
  "passwordConfirmation": "{{userResetPassword}}"
}

### 2.6 User Logout
# @name userLogout
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json
Authorization: Bearer {{userToken}}

{}

### 3. Content Section
# The content API is authenticated with the SAME user Bearer token produced by
# 2.2 User Login; the admin token from Section 1 is a different token type.
# Before running 3.1.3 / 3.1.4, copy the response `documentId` of the created
# record (Strapi 5 uses documentId, not the numeric id) into the matching
# REST_*_ID value in `.env`.

### 3.1 Student
### 3.1.1 Create Student
# @name studentCreate
POST {{baseUrl}}/api/students
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "studentCode": "{{studentCode}}",
    "firstname": "{{studentFirstname}}",
    "lastname": "{{studentLastname}}",
    "email": "{{studentEmail}}"
  }
}

### 3.1.2 List All Students
# @name studentListAll
GET {{baseUrl}}/api/students
Authorization: Bearer {{userToken}}

### 3.1.3 List Student with ID
# @name studentListOne
GET {{baseUrl}}/api/students/{{studentId}}
Authorization: Bearer {{userToken}}

### 3.1.4 Update Student
# @name studentUpdate
PUT {{baseUrl}}/api/students/{{studentId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "studentCode": "{{studentCode}}",
    "firstname": "{{studentFirstname}}",
    "lastname": "{{studentLastname}}",
    "email": "{{studentEmail}}"
  }
}

### 3.2 Subject
### 3.2.1 Create Subject
# @name subjectCreate
POST {{baseUrl}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "code": "{{subjectCode}}",
    "name": "{{subjectName}}",
    "credit": {{subjectCredit}}
  }
}

### 3.2.2 List All Subjects
# @name subjectListAll
GET {{baseUrl}}/api/subjects
Authorization: Bearer {{userToken}}

### 3.2.3 List Subject with ID
# @name subjectListOne
GET {{baseUrl}}/api/subjects/{{subjectId}}
Authorization: Bearer {{userToken}}

### 3.2.4 Update Subject
# @name subjectUpdate
PUT {{baseUrl}}/api/subjects/{{subjectId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "code": "{{subjectCode}}",
    "name": "{{subjectName}}",
    "credit": {{subjectCredit}}
  }
}

### 3.3 Teacher
### 3.3.1 Create Teacher
# @name teacherCreate
POST {{baseUrl}}/api/teachers
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "teacherCode": "{{teacherCode}}",
    "firstname": "{{teacherFirstname}}",
    "lastname": "{{teacherLastname}}",
    "email": "{{teacherEmail}}"
  }
}

### 3.3.2 List All Teachers
# @name teacherListAll
GET {{baseUrl}}/api/teachers
Authorization: Bearer {{userToken}}

### 3.3.3 List Teacher with ID
# @name teacherListOne
GET {{baseUrl}}/api/teachers/{{teacherId}}
Authorization: Bearer {{userToken}}

### 3.3.4 Update Teacher
# @name teacherUpdate
PUT {{baseUrl}}/api/teachers/{{teacherId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "teacherCode": "{{teacherCode}}",
    "firstname": "{{teacherFirstname}}",
    "lastname": "{{teacherLastname}}",
    "email": "{{teacherEmail}}"
  }
}