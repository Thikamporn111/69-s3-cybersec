# Copy to .env and fill every value with its OWN independently random secret.
# Never reuse one value in two variables.

# Database
DATABASE_PASSWORD=
DATABASE_USER=
DATABASE_DB=
DATABASE_HOST=
DATABASE_INTERNAL_PORT=
POSTGRES_DATA_PATH=

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=
PGADMIN_DATA_PATH=

# Application
APP_HOST=
APP_PORT=

# Strapi secrets
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=

# Initial Strapi administrator and REST test accounts
STRAPI_ADMIN_FIRSTNAME=
STRAPI_ADMIN_LASTNAME=
STRAPI_ADMIN_EMAIL=
STRAPI_ADMIN_PASSWORD=
# Runtime token: paste the admin's Bearer token to run Profile/Logout.
STRAPI_ADMIN_TOKEN=
# Runtime token: paste the admin reset code from the database before Reset Password.
STRAPI_ADMIN_RESET_TOKEN=
# Password the admin account will be reset to.
REST_ADMIN_RESET_PASSWORD=
REST_REMEMBER_ME=true
REST_USER_USERNAME=
REST_USER_EMAIL=
REST_USER_PASSWORD=
# User login identifier: registered username or email.
REST_USER_IDENTIFIER=
REST_RESET_PASSWORD=
# Runtime token: paste the user's Bearer token to run Profile/Logout.
REST_USER_TOKEN=
# Runtime token: paste the user reset code from the database before Reset Password.
REST_USER_RESET_CODE=

# Sessions (seconds). Defaults apply when left blank.
SESSION_ACCESS_TOKEN_LIFESPAN=600
SESSION_MAX_REFRESH_LIFESPAN=604800
SESSION_IDLE_REFRESH_LIFESPAN=86400
SESSION_MAX_LIFESPAN=43200
SESSION_IDLE_LIFESPAN=3600
# true puts the refresh token in an HttpOnly cookie instead of the JSON body.
SESSION_REFRESH_HTTPONLY=false

# Auth throttling
AUTH_RATE_LIMIT_INTERVAL_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Backups. Point BACKUP_DIR outside this project and outside any synced folder.
BACKUP_PASSPHRASE=
BACKUP_DIR=
