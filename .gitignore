# Secrets and local REST values
.env
.env.*
!.env.example
api.rest

# Local TLS material. Regenerate with security/certs/openssl.cnf; never commit.
security/certs/*.key
security/certs/*.crt
security/certs/*.pem
security/certs/*.csr
security/certs/*.srl
security/certs/*.p12
security/certs/*.pfx

# Persistent services data must never be committed
data/

# Strapi generated files
strapi/node_modules/
strapi/.cache/
strapi/.tmp/
strapi/build/
strapi/dist/
strapi/public/uploads/*
!strapi/public/uploads/.gitkeep

# Logs and OS/editor files
*.log
.DS_Store
Thumbs.db
.vscode/

# Local pre-audit backups
.backup-preaudit/

# Local secret-rotation notes and generated environment files
ROTATE-SECRETS.md
env.new
Claude outputs/

# Local backup output. BACKUP_DIR should point outside the project anyway;
# these patterns catch an encrypted dump that lands here by mistake.
backups/
*.sql
*.sql.gz
*.sql.gz.enc

# Security monitor output (holds IPs, request paths, and attack payloads).
scripts/reports/
security/reports/
