# Secrets and local REST values
.env
.env.*
!.env.example
api.rest

# Local TLS material. Regenerate with security/certs/openssl.cnf; never commit.
security/certs/*.key
security/certs/*.crt
security/certs/*.pem

# Persistent services data must never be committed
data/

# Strapi generated files
strapi/node_modules/
strapi/.cache/
strapi/.tmp/
strapi/build/
strapi/dist/
strapi/public/uploads/*
!strapi/public/uploads/.gitkeep

# Logs and OS/editor files
*.log
.DS_Store
Thumbs.db
.vscode/

# Local pre-audit backups
.backup-preaudit/
